body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    /*background: #5a3e2b; */
    color: #fff8e7;
}

header {
    background: #3e2723;
    color: #ffd54f; 
    text-align: center;
    padding: 25px;
    border-bottom: 4px solid #c62828;
}


nav {
    background: #4e342e;
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 12px;
}

nav a {
    color: #ffd54f; 
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    color: #ff5252; 
}


main {
    max-width: 900px;
    margin: 20px auto;
    padding: 10px;
}


.card {
    background: #fff8e1;
    color: #3e2723;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    border-left: 6px solid #c62828; 
}


h2 {
    margin-bottom: 15px;
    color: #bf360c; 
}


form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

input, select {
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #bcaaa4;
    font-size: 14px;
}


button {
    background: #c62828; 
    color: white;
    border: none;
    padding: 12px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #ff5252; 
}


.card:hover {
    transform: scale(1.01);
    transition: 0.2s;
}


@media (max-width: 600px) {
    nav {
        flex-direction: column;
        align-items: center;
    }
}

 
